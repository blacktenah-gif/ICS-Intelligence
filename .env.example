PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_BASE_URL=http://localhost:3000
# Used only for the one-time creation of the first administrator account.
ADMIN_SETUP_TOKEN=replace-with-a-long-one-time-setup-token
# Configure SMTP to send real email verification codes. Without SMTP, email codes are NOT printed or returned.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=ICS Intelligence <no-reply@example.com>
